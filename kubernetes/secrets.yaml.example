# Copy this file to secrets.yaml, replace every placeholder, and keep secrets.yaml
# out of version control. Use a URL-safe password because DATABASE_URL embeds it.
apiVersion: v1
kind: Secret
metadata:
  name: jaffelshop-secrets
  namespace: jaffelshop
type: Opaque
stringData:
  POSTGRES_USER: jaffelshop
  POSTGRES_PASSWORD: REPLACE_WITH_A_LONG_URL_SAFE_PASSWORD
  DATABASE_URL: postgresql://jaffelshop:REPLACE_WITH_THE_SAME_PASSWORD@postgres:5432/jaffelshop
  INTERNAL_SECRET: REPLACE_WITH_A_LONG_RANDOM_SECRET
